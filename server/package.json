{
  "name": "gwu-research-discovery-server",
  "version": "1.0.0",
  "description": "Apollo GraphQL server for the GWU Research Discovery Engine",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "node --test",
    "test:unit": "node --test test/guardrails.test.js",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "graphql": "^17.0.2",
    "openai": "^7.25.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
